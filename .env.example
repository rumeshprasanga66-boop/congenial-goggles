# Copy this file to .env.local and fill in the values you have.
# Never commit .env.local. It is already listed in .gitignore.

# ---------------------------------------------------------------------------
# Supabase (Phase 3 — authentication and document storage)
# Create a project at https://supabase.com, then open
# Project Settings -> API to find both values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser and never prefix it with
# NEXT_PUBLIC_. It bypasses row level security, so it is used only in trusted
# server code that has already checked the signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI provider (Phase 2 — generation, rewriting, brainstorming)
# Create a key at https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# The exact model identifier to use. Confirm it exists on your account before
# relying on it; do not assume a name is available.
OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Research provider (Phase 5 — source-backed research)
# Optional. Without it the research assistant reports that live research is
# unavailable rather than inventing sources.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Stripe (Phase 6 — billing)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
